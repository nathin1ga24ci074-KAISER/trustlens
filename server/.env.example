# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustlens?schema=public"

# Authentication / Security
# Replace with a cryptographically secure random string (minimum 32 characters)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"

# CORS Configuration
# Comma-separated list of allowed origins or single origin
CORS_ORIGIN="http://localhost:5173"

# Cookie Security
# Set to 'true' when running behind HTTPS in production
COOKIE_SECURE="false"

# AI Provider Strategy
# Primary: 'gemini' | 'groq'
AI_PRIMARY_PROVIDER="gemini"
# Fallback: 'groq' | 'gemini' | 'none'
AI_FALLBACK_PROVIDER="groq"

# Google Gemini API
# Acquire key at https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# Groq API
# Acquire key at https://console.groq.com/
GROQ_API_KEY=""
GROQ_MODEL="qwen/qwen3.8-27b"
