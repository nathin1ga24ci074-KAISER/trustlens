# TrustLens Environment Configuration Template
# Copy this file to server/.env and adjust values for your environment.

PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustlens?schema=public"
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key_minimum_32_characters"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:5173"
COOKIE_SECURE="false"
